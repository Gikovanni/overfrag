{
  "name": "overfrag",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @overfrag/shared build && pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @overfrag/shared build && pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm --filter @overfrag/shared build && vitest run",
    "test:watch": "pnpm --filter @overfrag/shared build && vitest",
    "test:e2e": "pnpm --filter @overfrag/shared build && playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.13.0",
    "prettier": "^3.6.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "5.0.5"
  }
}
